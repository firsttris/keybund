// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what Keybund builds on, plus the "Dependency Dashboard" issue listing what is open. Only Tauri
// with tauri-specta (the typed commands in app/src/lib/bindings.ts): the crates and the npm
// packages in one PR. OpenSSH and Git are the user's.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `npx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  packageRules: [
    {
      // Tauri and tauri-specta: the crates and the npm packages in one PR, since the CLI wants
      // them on matching versions. Tauri 3 alphas are left out (stable releases only).
      matchManagers: ["cargo", "npm"],
      matchPackageNames: [
        "tauri",
        "tauri-build",
        "tauri-plugin-*",
        "@tauri-apps/**",
        "specta",
        "specta-typescript",
        "tauri-specta",
      ],
      enabled: true,
      groupName: "Tauri",
      sourceUrl: "https://github.com/tauri-apps/tauri",
      prBodyNotes: [
        "Before merging: `cargo test` fails when `app/src/lib/bindings.ts` is outdated (run `just bindings` and commit it); `specta` must stay on the release candidate the new `tauri-specta` asks for (raise the `allowedVersions` of `specta` and `specta-typescript` in `.github/renovate.json5` on this branch). The macOS job runs the Rust suite; try the clipboard and the file dialogs in the AppImage (and the .dmg) of a `release.yml` run on this branch.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // specta and tauri-specta are release candidates, pinned exactly (=2.0.0-rc.x)
      matchManagers: ["cargo"],
      matchPackageNames: ["specta", "specta-typescript", "tauri-specta"],
      ignoreUnstable: false,
      respectLatest: false,
    },
    {
      // specta and specta-typescript only as far as the pinned tauri-specta allows: tauri-specta
      // 2.0.0-rc.26 requires specta =2.0.0-rc.26 and specta-typescript ^0.0.13, and
      // specta-typescript 0.0.14 already requires specta =2.0.0-rc.27 (crates.io), so a newer pair
      // cannot be resolved (#6). With a new tauri-specta in the Tauri PR, raise both bounds on
      // that branch to what it asks for.
      matchManagers: ["cargo"],
      matchPackageNames: ["specta"],
      allowedVersions: "<=2.0.0-rc.26",
    },
    {
      matchManagers: ["cargo"],
      matchPackageNames: ["specta-typescript"],
      allowedVersions: "<=0.0.13",
    },
  ],
}
